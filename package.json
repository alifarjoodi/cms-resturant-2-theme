{
  "name": "coffee-shop-eshobe-theme",
  "version": "1.0.0",
  "private": true,
  "description": "The original coffee-menu poster, rendered from Eshobe CMS contract v1.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node tests/browser.mjs && node tests/checkout-browser.mjs"
  },
  "dependencies": {
    "@eshobe/site-runtime": "file:vendor/eshobe-site-runtime"
  },
  "devDependencies": {
    "@sparticuz/chromium": "133.0.0",
    "playwright-core": "1.51.1"
  }
}
