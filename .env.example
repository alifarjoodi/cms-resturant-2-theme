# Copy to .env for local development. Never commit real credentials.
# Managed Eshobe deployments inject the platform variables automatically.
ESHOBE_CMS_URL=
ESHOBE_API_KEY=
ESHOBE_SITE_ID=
ESHOBE_SITE_DOMAIN=
ESHOBE_PUBLIC_ORIGIN=
ESHOBE_REVALIDATE_SECRET=

# Optional local overrides; the CMS descriptor is authoritative when connected.
ESHOBE_DEFAULT_LOCALE=fa
ESHOBE_LOCALES=fa,en
ESHOBE_SITE_TYPE=store
ESHOBE_CURRENCY=IRT
ESHOBE_CONTRACT_VERSION=1

# Required to display signed receipts in THIS theme. The operator must provision
# the CMS's PAYLOAD_SECRET here through a secret environment variable.
# It is NOT the revalidation secret. Never put it in a browser or a public URL.
ESHOBE_RECEIPT_SECRET=

# Explicit, read-only design preview with sample data; checkout is disabled.
# Leave false on a real deployment. Missing CMS configuration never implies demo.
DEMO_MODE=false
CACHE_TTL_SECONDS=60
PORT=3000
HOST=0.0.0.0
